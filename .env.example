# Copy to .env (or .env.local) and fill in. Never commit real values.
# Values left empty are reported as missing by scripts/validate_stack.py.

# --- Agent ---
# Model provider: meterless (default, primary: Meterless Nightshift) | nim (optional NVIDIA NIM fallback).
# Empty = meterless. NIM is only used when LLM_PROVIDER=nim is set explicitly.
LLM_PROVIDER=meterless
# Maximum ReAct steps per agent run
AGENT_MAX_STEPS=25
# Maximum rows returned to the agent per SQL query
AGENT_MAX_ROWS=50

# --- Inference (primary): Meterless Nightshift runtime, OpenAI-compatible, routes to NVIDIA Nemotron lanes ---
# Nightshift runtime token: start Nightshift, then copy the token it writes to <stateDir>/proxy-token
METERLESS_API_KEY=
# Nightshift runtime OpenAI-compatible endpoint
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
# App id sent to Meterless for usage attribution (meterless-app header)
METERLESS_APP_ID=open-agent-hackathon
# Routing lane: meterless/deep (Nemotron reasoning lane, used for the demo) | meterless/auto | meterless/fast
METERLESS_MODEL=meterless/deep

# --- Inference (optional fallback): NVIDIA Nemotron via NVIDIA NIM; only with LLM_PROVIDER=nim ---
# NVIDIA NIM API key (nvapi-..., https://build.nvidia.com -> Get API Key)
NVIDIA_NIM_API_KEY=
# NVIDIA NIM OpenAI-compatible endpoint
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Model id, e.g. nvidia/nemotron-3-ultra-550b-a55b (pick one from GET /v1/models)
NEMOTRON_MODEL=

# --- Decision memory: Meterless H-MEM engine (engines/hmem, needs Node 22.18+ on PATH) ---
# Uncomment to turn the engine off (compute_allocation then falls back to the approvals log)
# OMNI_HMEM=off
# Uncomment to use a specific node executable
# HMEM_NODE=

# --- Data: Zetaris (JDBC) ---
# Zetaris Lightning JDBC URL: jdbc:zetaris:lightning@<host>:<port> (local Docker stack listens on 10000)
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
# Full path to the driver JAR shipped in ./zetaris-platform/jdbc/
ZETARIS_JDBC_JAR=
# Zetaris user (ZETARIS_ADMIN_EMAIL in zetaris-platform/.env)
ZETARIS_USERNAME=
# Zetaris password (ZETARIS_ADMIN_PASSWORD in zetaris-platform/.env)
ZETARIS_PASSWORD=
# JDK 11+ folder for the JDBC driver; uncomment only if not set as a system variable
# JAVA_HOME=

# --- Data: Zetaris (REST) ---
# Zetaris REST API base
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
# Zetaris web UI base
ZETARIS_BASE_URL=http://localhost:3000
# Numeric organisation id: Zetaris web UI -> Management -> Organisation (used by REST calls)
ZETARIS_ORG_ID=
# REST API token: Zetaris web UI -> Management -> API Tokens -> create (admin scope). Used by the REST
# sql-editor endpoint (POST <ZETARIS_REST_URL>/sql-editor/sqls/run) and checked by scripts/validate_stack.py;
# the agent itself uses JDBC. Treat as a secret.
ZETARIS_API_KEY=
# true = Zetaris runs in local Docker (daemon must be running); false = remote instance
ZETARIS_USE_DOCKER=true

# --- Demo channel order DB (local Postgres, demo/docker-compose.channels.yml) ---
# Password for the demo order DB; must match the container's POSTGRES_PASSWORD
CHANNELS_DB_PASSWORD=omni_demo_pw
# Optional full connection URL; uncomment to override postgresql://omni:<password>@127.0.0.1:5433/channels
# CHANNELS_DB_URL=
# Optional ISO-8601 "today" for Scenario 1; uncomment to override today 00:00 UTC
# DEMO_NOW=
# Optional: interface the demo UI binds to (default 127.0.0.1). Process environment only; demo/server.py does not read .env
# OMNI_UI_HOST=127.0.0.1
